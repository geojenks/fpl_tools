// Cloudflare Worker "fpl-tools": the viewer (web/) plus the FPL API proxy.
// Workers Builds runs `npx wrangler deploy` on every push to the production branch.
{
  "name": "fpl-tools",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Request logs, viewable under the Worker's Observability tab.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
